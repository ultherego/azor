# Template for a published release: tag it and run updpkgsums first.
_owner=ultherego
pkgname=azor
pkgver=0.1.0
pkgrel=1
pkgdesc='Small desktop telemetry recorder'
arch=('x86_64' 'aarch64')
url="https://github.com/$_owner/azor"
license=('MIT')
depends=('systemd')
makedepends=('go')
optdepends=('nvidia-utils: NVIDIA GPU metrics'
            'hwdata: readable GPU names')
backup=('etc/azor/azor.conf')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SET_WITH_updpkgsums')

build() {
  cd "$pkgname-$pkgver"
  export GOTOOLCHAIN=local GOFLAGS=-mod=readonly
  make build
}
check() {
  cd "$pkgname-$pkgver"
  export GOTOOLCHAIN=local GOFLAGS=-mod=readonly
  make test
}
package() {
  cd "$pkgname-$pkgver"
  make install-system DESTDIR="$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
